{
	"name": "@kalyx/core",
	"version": "0.3.0",
	"description": "Kalyx core — platform-agnostic date logic, IANA timezone helpers, and the DateAdapter contract used by @kalyx/react",
	"license": "MIT",
	"author": "jiji-hoon96",
	"homepage": "https://github.com/jiji-hoon96/kalyx#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/jiji-hoon96/kalyx.git",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/jiji-hoon96/kalyx/issues"
	},
	"keywords": [
		"date",
		"datepicker",
		"calendar",
		"timezone",
		"iana",
		"dst",
		"iso8601",
		"utc",
		"date-fns"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"date-fns": "^4.0.0",
		"date-fns-tz": "^3.0.0"
	}
}
